<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="UnitySettingsMousePage" parent="AdwBin">
    <property name="child">
      <object class="AdwBreakpointBin">
        <property name="width-request">300</property>
        <property name="height-request">200</property>
        <child>
          <object class="AdwBreakpoint">
            <condition>max-width: 500sp</condition>
            <setter object="mouse_scroll_direction_box" property="orientation">vertical</setter>
          </object>
        </child>
        <property name="child">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">General</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Primary Button</property>
                    <property name="subtitle" translatable="yes">Order of physical buttons on mice and touchpads</property>
                    <child type="suffix">
                      <object class="AdwToggleGroup" id="primary_toggle_group">
                        <property name="valign">center</property>
                        <property name="homogeneous">True</property>
                        <property name="can-shrink">False</property>
                        <signal name="notify::active" handler="on_primary_button_changed_cb" object="UnitySettingsMousePage"/>
                        <child>
                          <object class="AdwToggle">
                            <property name="name">left</property>
                            <property name="label" translatable="yes">_Left</property>
                            <property name="use-underline">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwToggle">
                            <property name="name">right</property>
                            <property name="label" translatable="yes">_Right</property>
                            <property name="use-underline">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkGestureClick">
                            <property name="button">3</property>
                            <property name="exclusive">True</property>
                            <signal name="pressed" handler="primary_toggle_right_click_pressed_cb" object="UnitySettingsMousePage"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Mouse</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Po_inter Speed</property>
                    <property name="use-underline">True</property>
                    <property name="activatable-widget">mouse_speed_scale</property>
                    <child type="suffix">
                      <object class="GtkScale" id="mouse_speed_scale">
                        <property name="hexpand">True</property>
                        <marks>
                          <mark value="-1" position="bottom" translatable="yes">Slow</mark>
                          <mark value="0"/>
                          <mark value="1" position="bottom" translatable="yes">Fast</mark>
                        </marks>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">-1</property>
                            <property name="upper">1</property>
                            <property name="step-increment">0.1</property>
                            <property name="page-increment">0.1</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Mouse _Acceleration</property>
                    <property name="subtitle" translatable="yes">Recommended for most users and applications</property>
                    <property name="use-underline">True</property>
                    <property name="activatable-widget">mouse_accel_switch</property>
                    <child type="suffix">
                      <object class="GtkMenuButton">
                        <property name="tooltip-text" translatable="yes">More Information</property>
                        <property name="icon-name">info-outline-symbolic</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat"/>
                        </style>
                        <property name="popover">
                          <object class="GtkPopover">
                            <property name="child">
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Turning mouse acceleration off can allow faster and more precise movements, but can also make the mouse more difficult to use.</property>
                                <property name="margin-top">6</property>
                                <property name="margin-bottom">6</property>
                                <property name="margin-start">6</property>
                                <property name="margin-end">6</property>
                                <property name="max-width-chars">50</property>
                                <property name="wrap">True</property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child type="suffix">
                      <object class="GtkSwitch" id="mouse_accel_switch">
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Scroll Direction</property>
                <child>
                  <object class="AdwPreferencesRow">
                    <property name="activatable">False</property>
                    <property name="child">
                      <object class="GtkBox" id="mouse_scroll_direction_box">
                        <property name="accessible-role">radio-group</property>
                        <property name="homogeneous">True</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="UnitySettingsIllustration" id="mouse_scroll_traditional_image">
                                <property name="resource">/org/unity/Settings/mouse-touchpad/scroll-traditional.svg</property>
                                <property name="height-request">196</property>
                                <property name="check-button">mouse_scroll_traditional</property>
                                <style>
                                  <class name="frame"/>
                                  <class name="view"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="mouse_scroll_traditional">
                                <property name="label" translatable="yes">Tra_ditional</property>
                                <property name="use-underline">True</property>
                                <property name="margin-top">6</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="UnitySettingsIllustration" id="mouse_scroll_natural_image">
                                <property name="resource">/org/unity/Settings/mouse-touchpad/scroll-natural.svg</property>
                                <property name="height-request">196</property>
                                <property name="check-button">mouse_scroll_natural</property>
                                <style>
                                  <class name="frame"/>
                                  <class name="view"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="mouse_scroll_natural">
                                <property name="label" translatable="yes">_Natural</property>
                                <property name="use-underline">True</property>
                                <property name="margin-top">6</property>
                                <property name="group">mouse_scroll_traditional</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
