<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="UnitySettingsIllustration" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBinLayout"/>
    </property>
    <child>
      <object class="GtkEventControllerMotion">
        <signal name="enter" handler="enter_cb" swapped="yes"/>
        <signal name="leave" handler="leave_cb" swapped="yes"/>
      </object>
    </child>
    <child>
      <object class="GtkGestureClick">
        <signal name="released" handler="released_cb" swapped="yes"/>
      </object>
    </child>
    <child>
      <object class="GtkPicture" id="picture">
        <property name="content-fit">scale-down</property>
      </object>
    </child>
  </template>
</interface>
